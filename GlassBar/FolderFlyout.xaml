<local:FlyoutBase x:Class="GlassBar.FolderFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GlassBar"
        Title="GlassBar Ordner">
    <local:FlyoutBase.Resources>
        <!-- Ein Icon im Raster -->
        <DataTemplate x:Key="EntryTemplate">
            <Border Style="{StaticResource BarButton}" Width="96" Height="100" Margin="2"
                    ToolTip="{Binding Item.DisplayName}"
                    PreviewMouseLeftButtonDown="Item_MouseDown" MouseMove="Item_MouseMove"
                    MouseLeftButtonUp="Item_Click" MouseRightButtonUp="Item_RightClick">
                <StackPanel VerticalAlignment="Top" Margin="0,10,0,0">
                    <Image Source="{Binding Item.ExtraLargeIcon}" Width="44" Height="44"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Item.DisplayName}" Foreground="{DynamicResource Fg}" FontSize="11.5"
                               TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="32" Margin="4,6,4,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </local:FlyoutBase.Resources>

    <Border Padding="12,10,12,12">
        <DockPanel>
            <!-- Kopfzeile: Zurück, Titel, Suche, neue Gruppe, im Explorer öffnen -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" Height="32">
                <Border x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource BarButton}" Width="32"
                        Margin="0,0,4,0" ToolTip="Zurück" Visibility="Collapsed" MouseLeftButtonUp="Back_Click">
                    <TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" FontSize="13"/>
                </Border>
                <Border DockPanel.Dock="Right" Style="{StaticResource BarButton}" Width="32" Margin="4,0,0,0"
                        ToolTip="Im Explorer öffnen" MouseLeftButtonUp="Explorer_Click">
                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" FontSize="13"/>
                </Border>
                <Border DockPanel.Dock="Right" Style="{StaticResource BarButton}" Width="32" Margin="4,0,0,0"
                        ToolTip="Neue Gruppe" MouseLeftButtonUp="NewGroup_Click">
                    <TextBlock Text="&#xE8F4;" Style="{StaticResource Glyph}" FontSize="14"/>
                </Border>
                <Grid DockPanel.Dock="Right" Width="170">
                    <Border CornerRadius="6" Background="{DynamicResource Field}" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="12" Opacity="0.6"
                               HorizontalAlignment="Left" Margin="9,0,0,0"/>
                    <TextBlock x:Name="SearchHint" Text="Suchen" Foreground="{DynamicResource FgDim}" FontSize="12"
                               VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Fg}"
                             CaretBrush="{DynamicResource Fg}" FontSize="12" VerticalAlignment="Center" Margin="26,0,6,0"
                             TextChanged="Search_Changed"/>
                </Grid>
                <TextBlock x:Name="TitleText" Foreground="{DynamicResource Fg}" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="4,0,12,0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <TextBlock x:Name="EmptyText" DockPanel.Dock="Bottom" Foreground="{DynamicResource FgDim}" Margin="4,8"
                       Visibility="Collapsed"/>

            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Sections">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Eine Gruppe (oder "Weitere") -->
                            <StackPanel Margin="0,0,0,6" Background="Transparent" AllowDrop="True"
                                        DragOver="Section_DragOver" Drop="Section_Drop">
                                <Border Style="{StaticResource BarButton}" Height="30" Margin="0,0,0,2"
                                        Visibility="{Binding HeaderVisibility}"
                                        MouseLeftButtonUp="Header_Click" MouseRightButtonUp="Header_RightClick">
                                    <StackPanel Orientation="Horizontal" Margin="8,0">
                                        <TextBlock Text="{Binding Chevron}" Style="{StaticResource Glyph}" FontSize="10"
                                                   Width="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Header}" Foreground="{DynamicResource Fg}" FontSize="13"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Count}" Foreground="{DynamicResource FgDim}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding ItemsVisibility}"
                                              ItemTemplate="{StaticResource EntryTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Text="Symbole hierher ziehen" Foreground="{DynamicResource FgDisabled}" FontSize="11"
                                           Margin="30,4,0,6" Visibility="{Binding EmptyHintVisibility}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</local:FlyoutBase>

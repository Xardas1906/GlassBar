<Window x:Class="GlassBar.SettingsWindow"
        Icon="Assets/GlassBar.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GlassBar"
        Title="GlassBar – Einstellungen" Width="900" Height="720"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent" Foreground="White"
        WindowStartupLocation="CenterScreen" FontSize="13" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="56" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:EqualsConverter x:Key="Eq"/>
        <SolidColorBrush x:Key="Card" Color="#0EFFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="Sub" Color="#99FFFFFF"/>

        <!-- Schmale, dunkle Bildlaufleiste -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#40FFFFFF" Margin="2,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation links -->
        <Style x:Key="NavGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        </Style>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Height="38" Margin="0,1">
                            <Border x:Name="Bd" CornerRadius="6" Background="Transparent"/>
                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{StaticResource Accent}" Visibility="Hidden"/>
                            <ContentPresenter VerticalAlignment="Center" Margin="14,0,8,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1CFFFFFF"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Abschnitt-Überschrift -->
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,22,0,8"/>
        </Style>

        <!-- Karte mit Zeilen -->
        <Style x:Key="CardBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,4"/>
        </Style>

        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,16,8"/>
        </Style>

        <Style x:Key="RowLine" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>

        <!-- Kippschalter wie in den Windows-Einstellungen -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="#99FFFFFF" Background="Transparent"/>
                            <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#DDFFFFFF" HorizontalAlignment="Left"
                                     Margin="4,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Knob" Property="Fill" Value="Black"/>
                                <Setter TargetName="Knob" Property="Margin" Value="24,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Width" Value="14"/>
                                <Setter TargetName="Knob" Property="Height" Value="14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Schieberegler -->
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="20" Height="20">
                            <Ellipse Fill="#454545" Stroke="#30FFFFFF"/>
                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource Accent}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="13"/>
                                <Setter TargetName="Dot" Property="Height" Value="13"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Slide" TargetType="Slider">
            <Setter Property="Width" Value="220"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Height="22">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeat}" Background="{StaticResource Accent}"
                                              Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeat}" Background="#50FFFFFF"
                                              Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Auswahl-Knöpfe nebeneinander -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Padding="12,7" Margin="0,0,6,6" Background="#14FFFFFF"
                                BorderBrush="#20FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#664CC2FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Farbfeld -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ring" Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0"
                                BorderThickness="2" BorderBrush="Transparent" ToolTip="{TemplateBinding ToolTip}">
                            <Ellipse Width="22" Height="22" Fill="{TemplateBinding Background}" Stroke="#40FFFFFF"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Button" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="14,8" Margin="0,0,8,0" Background="#1EFFFFFF"
                                BorderBrush="#24FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Rahmen wie beim Dock: heller Verlauf oben, leichter Glanz -->
    <Border x:Name="Frame" BorderThickness="1" CornerRadius="8">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#40FFFFFF" Offset="0"/>
                <GradientStop Color="#14FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#14FFFFFF" Offset="0"/>
                <GradientStop Color="#06FFFFFF" Offset="0.3"/>
                <GradientStop Color="#04FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

    <DockPanel>
        <!-- Titelleiste mit dem Start-Symbol aus dem Dock -->
        <DockPanel DockPanel.Dock="Top" Height="56" Margin="18,0,0,0">
            <Border DockPanel.Dock="Right" Width="46" Height="34" VerticalAlignment="Top" x:Name="CloseButton"
                    WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" CornerRadius="0,7,0,0"
                    MouseLeftButtonUp="Close_Click" ToolTip="Schließen">
                <TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" FontSize="10"/>
            </Border>
            <Image Source="Assets/GlassBar.png" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="GlassBar" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Einstellungen" FontSize="11.5" Foreground="{StaticResource Sub}"/>
            </StackPanel>
        </DockPanel>

        <!-- Navigation links (wie in den Windows-Einstellungen) -->
        <DockPanel DockPanel.Dock="Left" Width="200" Margin="10,8,0,10">
        <!-- Suche über alle Einstellungen -->
        <Border DockPanel.Dock="Top" Width="190" HorizontalAlignment="Left" Height="34" Margin="0,0,0,8" CornerRadius="6"
                Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1">
            <Grid>
                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource Sub}"
                           HorizontalAlignment="Left" Margin="11,0,0,0"/>
                <TextBlock x:Name="SearchHint" Text="Einstellung suchen" Foreground="{StaticResource Sub}" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="32,0,0,0"/>
                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                         SelectionBrush="{StaticResource Accent}" VerticalContentAlignment="Center" Padding="28,0,24,0"
                         TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                <TextBlock x:Name="SearchClear" Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="10" Cursor="Hand"
                           HorizontalAlignment="Right" Margin="0,0,10,0" Visibility="Collapsed"
                           MouseLeftButtonUp="SearchClear_Click" ToolTip="Suche leeren"/>
            </Grid>
        </Border>
        <ScrollViewer x:Name="NavScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <StackPanel x:Name="SearchResults" Width="190" HorizontalAlignment="Left" Visibility="Collapsed"/>
        <StackPanel x:Name="Nav" Width="190" HorizontalAlignment="Left">
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="SecLook" Checked="Nav_Checked" IsChecked="True">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Aussehen"/></StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="SecStart" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Start-Knopf"/></StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="SecItems" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A9;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Dock-Inhalt"/></StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="SecInfo" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Uhr, Musik &amp; Wetter"/></StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="SecHide" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B3;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Ein- und Ausblenden"/></StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="SecScreens" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Mehrere Bildschirme"/></StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="SecFlyouts" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Aufklapp-Fenster"/></StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="SecWallpaper" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE91B;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Hintergrund"/></StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="SecSystem" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE770;" Style="{StaticResource NavGlyph}"/><TextBlock Text="System"/></StackPanel>
            </RadioButton>
            <!-- eigene Seite: Einstellungen des Hintergrunds -->
            <Border Height="1" Background="#20FFFFFF" Margin="10,10,10,6"/>
            <TextBlock Text="Hintergrund-Einstellungen" FontSize="11.5" Foreground="{StaticResource Sub}" Margin="14,2,0,4"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="StillPage" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE771;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Still"/></StackPanel>
            </RadioButton>
        </StackPanel>
        </Grid>
        </ScrollViewer>
        </DockPanel>

        <Grid>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="18,0,22,22" ScrollChanged="Scroller_ScrollChanged">
            <StackPanel x:Name="Content_">
                <TextBlock Text="Änderungen wirken sofort und werden automatisch gespeichert."
                           Foreground="{StaticResource Sub}" Margin="4,10,0,0"/>

                <!-- ============ Aussehen ============ -->
                <TextBlock x:Name="SecLook" Text="Aussehen" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Style="{StaticResource Swatch}" Background="#181818" ToolTip="Dunkelgrau" GroupName="Tint"
                                             IsChecked="{Binding TintColor, Converter={StaticResource Eq}, ConverterParameter=#181818}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#000000" ToolTip="Schwarz" GroupName="Tint"
                                             IsChecked="{Binding TintColor, Converter={StaticResource Eq}, ConverterParameter=#000000}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#1C2738" ToolTip="Blaugrau" GroupName="Tint"
                                             IsChecked="{Binding TintColor, Converter={StaticResource Eq}, ConverterParameter=#1C2738}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#2A1E3C" ToolTip="Violett" GroupName="Tint"
                                             IsChecked="{Binding TintColor, Converter={StaticResource Eq}, ConverterParameter=#2A1E3C}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#1E3328" ToolTip="Tannengrün" GroupName="Tint"
                                             IsChecked="{Binding TintColor, Converter={StaticResource Eq}, ConverterParameter=#1E3328}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#8A8A92" ToolTip="Hellgrau" GroupName="Tint"
                                             IsChecked="{Binding TintColor, Converter={StaticResource Eq}, ConverterParameter=#8A8A92}"/>
                            </StackPanel>
                            <TextBlock Text="Farbe des Glases" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding DockOpacity, StringFormat={}{0:0} %}" Foreground="{StaticResource Sub}"/>
                            <Slider DockPanel.Dock="Right" Style="{StaticResource Slide}" Minimum="0" Maximum="100"
                                    Value="{Binding DockOpacity}"/>
                            <TextBlock Text="Deckkraft des Docks" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding FlyoutOpacity, StringFormat={}{0:0} %}" Foreground="{StaticResource Sub}"/>
                            <Slider DockPanel.Dock="Right" Style="{StaticResource Slide}" Minimum="0" Maximum="100"
                                    Value="{Binding FlyoutOpacity}"/>
                            <TextBlock Text="Deckkraft von Desktop-Fenster und Vorschau" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding MenuOpacity, StringFormat={}{0:0} %}" Foreground="{StaticResource Sub}"/>
                            <Slider DockPanel.Dock="Right" Style="{StaticResource Slide}" Minimum="20" Maximum="100"
                                    Value="{Binding MenuOpacity}"/>
                            <TextBlock Text="Deckkraft der Kontextmenüs" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding IconSize, StringFormat={}{0:0} px}" Foreground="{StaticResource Sub}"/>
                            <Slider DockPanel.Dock="Right" Style="{StaticResource Slide}" Minimum="20" Maximum="48"
                                    TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding IconSize}"/>
                            <TextBlock Text="Icon-Größe" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding BottomMargin, StringFormat={}{0:0} px}" Foreground="{StaticResource Sub}"/>
                            <Slider DockPanel.Dock="Right" Style="{StaticResource Slide}" Minimum="0" Maximum="40"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BottomMargin}"/>
                            <TextBlock Text="Abstand zum unteren Rand" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowRunningDots}"/>
                            <TextBlock Text="Punkt unter laufenden Programmen" Style="{StaticResource Label}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ============ Start-Knopf ============ -->
                <TextBlock x:Name="SecStart" Text="Start-Knopf" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowStartButton}"/>
                            <TextBlock Text="Startknopf" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <StackPanel Margin="0,12,0,12">
                            <TextBlock Text="Start-Symbol" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <RadioButton Style="{StaticResource Segment}" GroupName="StartIcon" Content="Blaue Kachel"
                                             IsChecked="{Binding StartIcon, Converter={StaticResource Eq}, ConverterParameter=Tile}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="StartIcon" Content="Glas"
                                             IsChecked="{Binding StartIcon, Converter={StaticResource Eq}, ConverterParameter=Glass}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="StartIcon" Content="Nur Logo"
                                             IsChecked="{Binding StartIcon, Converter={StaticResource Eq}, ConverterParameter=Logo}"/>
                                <RadioButton x:Name="StartIconCustom" Style="{StaticResource Segment}" GroupName="StartIcon" Content="Eigenes Bild …"
                                             IsChecked="{Binding StartIcon, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Custom}"
                                             Click="StartIconCustom_Click"/>
                            </WrapPanel>
                        </StackPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding StartIcon, Converter={StaticResource Eq}, ConverterParameter=Tile}">
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <RadioButton Style="{StaticResource Swatch}" Background="#3B82F6" ToolTip="Blau (wie Windows)" GroupName="StartTileColor"
                                             IsChecked="{Binding StartTileColor, Converter={StaticResource Eq}, ConverterParameter=Blue}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="{x:Static SystemParameters.WindowGlassBrush}" ToolTip="Windows-Akzentfarbe" GroupName="StartTileColor"
                                             IsChecked="{Binding StartTileColor, Converter={StaticResource Eq}, ConverterParameter=Accent}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#7C3AED" ToolTip="Violett" GroupName="StartTileColor"
                                             IsChecked="{Binding StartTileColor, Converter={StaticResource Eq}, ConverterParameter=#7C3AED}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#16A34A" ToolTip="Grün" GroupName="StartTileColor"
                                             IsChecked="{Binding StartTileColor, Converter={StaticResource Eq}, ConverterParameter=#16A34A}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#DC2626" ToolTip="Rot" GroupName="StartTileColor"
                                             IsChecked="{Binding StartTileColor, Converter={StaticResource Eq}, ConverterParameter=#DC2626}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#EA580C" ToolTip="Orange" GroupName="StartTileColor"
                                             IsChecked="{Binding StartTileColor, Converter={StaticResource Eq}, ConverterParameter=#EA580C}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#DB2777" ToolTip="Pink" GroupName="StartTileColor"
                                             IsChecked="{Binding StartTileColor, Converter={StaticResource Eq}, ConverterParameter=#DB2777}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#475569" ToolTip="Grau" GroupName="StartTileColor"
                                             IsChecked="{Binding StartTileColor, Converter={StaticResource Eq}, ConverterParameter=#475569}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#111111" ToolTip="Schwarz" GroupName="StartTileColor"
                                             IsChecked="{Binding StartTileColor, Converter={StaticResource Eq}, ConverterParameter=#111111}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Label}">
                                Farbe der Kachel
                                <LineBreak/><Run Text="Nur bei „Blaue Kachel“." Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <StackPanel Margin="0,12,0,12">
                            <TextBlock Text="Windows-Logo" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <RadioButton Style="{StaticResource Segment}" GroupName="StartLogoStyle" Content="Quadrate"

                                <Border CornerRadius="6" Background="#18FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"/>
                                <TextBox x:Name="TasksBox" Text="{Binding WallpaperTasks, UpdateSourceTrigger=LostFocus}"
                                         Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                         FontSize="12" Padding="6,7" LostFocus="City_LostFocus" KeyDown="Tasks_KeyDown"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Label}">
                                Heutige Aufgaben
                                <LineBreak/><Run Text="Erscheinen unter der Uhr. Mehrere mit ; trennen." Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding ShowWallpaper}">
                            <TextBlock DockPanel.Dock="Right" Width="60" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding WallpaperFps, StringFormat={}{0:0} fps}" Foreground="{StaticResource Sub}"/>
                            <Slider DockPanel.Dock="Right" Style="{StaticResource Slide}" Minimum="10" Maximum="60"
                                    TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding WallpaperFps}"/>
                            <TextBlock Style="{StaticResource Label}">
                                Bildrate des Hintergrunds
                                <LineBreak/><Run Text="Weniger Bilder pro Sekunde = weniger Last für CPU und Grafikkarte." Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ============ System ============ -->
                <TextBlock x:Name="SecSystem" Text="System" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="AutostartBox" Style="{StaticResource Toggle}" Click="Autostart_Click"/>
                            <TextBlock Text="Mit Windows starten" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding SettingsGlass}"/>
                            <TextBlock Style="{StaticResource Label}">
                                Glaseffekt im Einstellungsfenster
                                <LineBreak/><Run Text="Ausschalten, wenn es bei offenen Einstellungen ruckelt (schwächere Grafikkarten)." Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource Button}" Margin="0"
                                    Content="Nach Updates suchen" Click="Update_Click" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Label}">
                                <Run Text="Updates"/>
                                <LineBreak/><Run x:Name="UpdateStatus" Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <WrapPanel Margin="0,12,0,12">
                            <Button Style="{StaticResource Button}" Content="Auf Standard zurücksetzen" Click="Reset_Click"/>
                            <Button Style="{StaticResource Button}" Content="Einstellungsordner öffnen" Click="OpenFolder_Click"/>
                            <Button Style="{StaticResource Button}" Content="GlassBar beenden" Click="Quit_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Einstellungs-Panel des Hintergrunds „Still“, direkt hier statt auf dem Desktop -->
        <DockPanel x:Name="StillPage" Visibility="Collapsed" Margin="18,6,22,22">
            <TextBlock x:Name="StillTitle" DockPanel.Dock="Top" Text="Still" FontSize="15" FontWeight="SemiBold" Margin="4,4,0,4"/>
            <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="4,0,0,10"
                       Text="Alle Einstellungen des Hintergrunds „Still“. Änderungen sieht man sofort im Hintergrund."/>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button Style="{StaticResource Button}" Content="Pillen und Uhr anordnen" Click="StillEditLayout_Click"
                        ToolTip="Öffnet auf dem Desktop den Anordnen-Modus. Fertig: auf eine freie Stelle klicken."/>
            </WrapPanel>
            <TextBlock x:Name="StillMissing" DockPanel.Dock="Top" Foreground="{StaticResource Sub}" Margin="4,0" Visibility="Collapsed"
                       Text="Schalte zuerst unter „Hintergrund“ den Hintergrund von GlassBar ein."/>
            <WrapPanel x:Name="StillTabs" DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="Collapsed"/>
            <ScrollViewer x:Name="StillScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel x:Name="StillContent"/>
            </ScrollViewer>
        </DockPanel>
        </Grid>
    </DockPanel>
    </Border>
</Window>

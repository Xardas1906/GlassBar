                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowSearchButton}"/>
                            <TextBlock Text="Suche" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowTaskViewButton}"/>
                            <TextBlock Text="Aktive Anwendungen" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowDesktopButton}"/>
                            <TextBlock Text="Desktop-Stapel" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <StackPanel Margin="0,12,0,12" IsEnabled="{Binding ShowDesktopButton}">
                            <TextBlock Text="Symbol des Desktop-Stapels" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <RadioButton Style="{StaticResource Segment}" GroupName="DesktopIcon" ToolTip="Windows-Ordner"
                                             IsChecked="{Binding DesktopIcon, Converter={StaticResource Eq}, ConverterParameter=Folder}"><TextBlock Text="Windows" FontSize="12"/></RadioButton>
                                <RadioButton Style="{StaticResource Segment}" GroupName="DesktopIcon" ToolTip="Bildschirm"
                                             IsChecked="{Binding DesktopIcon, Converter={StaticResource Eq}, ConverterParameter=Monitor}"><TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/></RadioButton>
                                <RadioButton Style="{StaticResource Segment}" GroupName="DesktopIcon" ToolTip="Ordner"
                                             IsChecked="{Binding DesktopIcon, Converter={StaticResource Eq}, ConverterParameter=Folder2}"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/></RadioButton>
                                <RadioButton Style="{StaticResource Segment}" GroupName="DesktopIcon" ToolTip="Stapel"
                                             IsChecked="{Binding DesktopIcon, Converter={StaticResource Eq}, ConverterParameter=Stack}"><TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/></RadioButton>
                                <RadioButton Style="{StaticResource Segment}" GroupName="DesktopIcon" ToolTip="Zuhause"
                                             IsChecked="{Binding DesktopIcon, Converter={StaticResource Eq}, ConverterParameter=Home}"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/></RadioButton>
                                <RadioButton Style="{StaticResource Segment}" GroupName="DesktopIcon" ToolTip="Stern"
                                             IsChecked="{Binding DesktopIcon, Converter={StaticResource Eq}, ConverterParameter=Star}"><TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/></RadioButton>
                                <RadioButton Style="{StaticResource Segment}" GroupName="DesktopIcon" ToolTip="Herz"
                                             IsChecked="{Binding DesktopIcon, Converter={StaticResource Eq}, ConverterParameter=Heart}"><TextBlock Text="&#xEB51;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/></RadioButton>
                                <RadioButton Style="{StaticResource Segment}" GroupName="DesktopIcon" ToolTip="Raster"
                                             IsChecked="{Binding DesktopIcon, Converter={StaticResource Eq}, ConverterParameter=Grid}"><TextBlock Text="&#xF0E2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/></RadioButton>
                                <RadioButton x:Name="DesktopIconCustom" Style="{StaticResource Segment}" GroupName="DesktopIcon" Content="Eigenes Bild …"
                                             IsChecked="{Binding DesktopIcon, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Custom}"
                                             Click="DesktopIconCustom_Click"/>
                            </WrapPanel>
                            <TextBlock Text="Windows-Symbole" Foreground="{StaticResource Sub}" FontSize="12" Margin="0,10,0,6"/>
                            <WrapPanel x:Name="DesktopGallery"/>
                        </StackPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding ShowDesktopButton}">
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <RadioButton Style="{StaticResource Swatch}" Background="#3B82F6" ToolTip="Blau" GroupName="DesktopTileColor"
                                             IsChecked="{Binding DesktopTileColor, Converter={StaticResource Eq}, ConverterParameter=#3B82F6}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="{x:Static SystemParameters.WindowGlassBrush}" ToolTip="Windows-Akzentfarbe" GroupName="DesktopTileColor"
                                             IsChecked="{Binding DesktopTileColor, Converter={StaticResource Eq}, ConverterParameter=Accent}"/>
                                <RadioButton Style="{StaticResource Swatch}" ToolTip="Transparent (kein Hintergrund)" GroupName="DesktopTileColor"
                                             IsChecked="{Binding DesktopTileColor, Converter={StaticResource Eq}, ConverterParameter=Transparent}">
                                    <RadioButton.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#00FFFFFF" Offset="0.45"/>
                                            <GradientStop Color="#E05050" Offset="0.47"/>
                                            <GradientStop Color="#E05050" Offset="0.53"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                                        </LinearGradientBrush>
                                    </RadioButton.Background>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Swatch}" Background="#40FFFFFF" ToolTip="Glas" GroupName="DesktopTileColor"
                                             IsChecked="{Binding DesktopTileColor, Converter={StaticResource Eq}, ConverterParameter=Glass}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#7C3AED" ToolTip="Violett" GroupName="DesktopTileColor"
                                             IsChecked="{Binding DesktopTileColor, Converter={StaticResource Eq}, ConverterParameter=#7C3AED}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#16A34A" ToolTip="Grün" GroupName="DesktopTileColor"
                                             IsChecked="{Binding DesktopTileColor, Converter={StaticResource Eq}, ConverterParameter=#16A34A}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#DC2626" ToolTip="Rot" GroupName="DesktopTileColor"
                                             IsChecked="{Binding DesktopTileColor, Converter={StaticResource Eq}, ConverterParameter=#DC2626}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#EA580C" ToolTip="Orange" GroupName="DesktopTileColor"
                                             IsChecked="{Binding DesktopTileColor, Converter={StaticResource Eq}, ConverterParameter=#EA580C}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#DB2777" ToolTip="Pink" GroupName="DesktopTileColor"
                                             IsChecked="{Binding DesktopTileColor, Converter={StaticResource Eq}, ConverterParameter=#DB2777}"/>
                                <RadioButton Style="{StaticResource Swatch}" Background="#475569" ToolTip="Grau" GroupName="DesktopTileColor"
                                             IsChecked="{Binding DesktopTileColor, Converter={StaticResource Eq}, ConverterParameter=#475569}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Label}">
                                Farbe hinter dem Symbol
                                <LineBreak/><Run Text="Für die einfachen Symbole; Windows-Symbole und eigene Bilder bringen ihre eigene Form mit." Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowPeekButton}"/>
                            <TextBlock Style="{StaticResource Label}">
                                Knopf „Desktop anzeigen“ ganz rechts
                                <LineBreak/><Run Text="Minimiert alle Fenster wie der schmale Knopf an der Windows-Taskleiste; nochmal klicken holt sie zurück." Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ============ Uhr, Musik &amp; Wetter ============ -->
                <TextBlock x:Name="SecInfo" Text="Uhr, Musik &amp; Wetter" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowMusic}"/>
                            <TextBlock Style="{StaticResource Label}">
                                Musik: was gerade läuft, mit Cover und Tasten
                                <LineBreak/><Run Text="Für alles, was in der Windows-Mediensteuerung erscheint (Spotify, Browser …)." Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <StackPanel Margin="0,12,0,6" IsEnabled="{Binding ShowWallpaper}">
                            <TextBlock Margin="0,0,0,10">
                                Musik anzeigen
                                <LineBreak/><Run Text="Im Hintergrund nur, wenn der Hintergrund „Still“ eingeschaltet ist." Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                            <WrapPanel>
                                <RadioButton Style="{StaticResource Segment}" GroupName="PlaceMusic" Content="Im Dock"
                                             IsChecked="{Binding MusicPlacement, Converter={StaticResource Eq}, ConverterParameter=Dock}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="PlaceMusic" Content="Im Hintergrund"
                                             IsChecked="{Binding MusicPlacement, Converter={StaticResource Eq}, ConverterParameter=Wallpaper}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="PlaceMusic" Content="Beides"
                                             IsChecked="{Binding MusicPlacement, Converter={StaticResource Eq}, ConverterParameter=Both}"/>
                            </WrapPanel>
                        </StackPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowWeather}"/>
                            <TextBlock Text="Wetter neben der Uhr" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <StackPanel Margin="0,12,0,6" IsEnabled="{Binding ShowWallpaper}">
                            <TextBlock Margin="0,0,0,10">
                                Wetter anzeigen
                                <LineBreak/><Run Text="Im Hintergrund nur, wenn der Hintergrund „Still“ eingeschaltet ist." Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                            <WrapPanel>
                                <RadioButton Style="{StaticResource Segment}" GroupName="PlaceWeather" Content="Im Dock"
                                             IsChecked="{Binding WeatherPlacement, Converter={StaticResource Eq}, ConverterParameter=Dock}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="PlaceWeather" Content="Im Hintergrund"
                                             IsChecked="{Binding WeatherPlacement, Converter={StaticResource Eq}, ConverterParameter=Wallpaper}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="PlaceWeather" Content="Beides"
                                             IsChecked="{Binding WeatherPlacement, Converter={StaticResource Eq}, ConverterParameter=Both}"/>
                            </WrapPanel>
                        </StackPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding ShowWeather}">
                            <Grid DockPanel.Dock="Right" Width="220" VerticalAlignment="Center">
                                <Border CornerRadius="6" Background="#18FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"/>
                                <TextBlock x:Name="CityHint" Foreground="#70FFFFFF" FontSize="12" Margin="10,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox x:Name="CityBox" Text="{Binding WeatherCity, UpdateSourceTrigger=LostFocus}"
                                         Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                         FontSize="12" Padding="6,7" LostFocus="City_LostFocus" KeyDown="City_KeyDown"
                                         TextChanged="City_TextChanged"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Label}">
                                Stadt fürs Wetter
                                <LineBreak/><Run Text="Leer lassen, um die Stadt aus dem Hintergrund „Still“ zu nehmen." Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowTray}"/>
                            <TextBlock Text="Infobereich (Symbole neben der Uhr)" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowQuickSettings}"/>
                            <TextBlock Text="Schnelleinstellungen (WLAN, Lautstärke, Akku)" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowClock}"/>
                            <TextBlock Text="Uhr" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowDate}"/>
                            <TextBlock Text="Datum unter der Uhr" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowSeconds}"/>
                            <TextBlock Text="Sekunden anzeigen" Style="{StaticResource Label}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ============ Ein- und Ausblenden ============ -->
                <TextBlock x:Name="SecHide" Text="Ein- und Ausblenden" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <StackPanel Margin="0,12,0,12">
                            <TextBlock Text="Dock ausblenden" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <RadioButton Style="{StaticResource Segment}" GroupName="Hide" Content="Wenn ein Fenster darüber liegt"
                                             IsChecked="{Binding AutoHideMode, Converter={StaticResource Eq}, ConverterParameter=Covered}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="Hide" Content="Nur bei Vollbild"
                                             IsChecked="{Binding AutoHideMode, Converter={StaticResource Eq}, ConverterParameter=FullScreen}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="Hide" Content="Nie"
                                             IsChecked="{Binding AutoHideMode, Converter={StaticResource Eq}, ConverterParameter=Never}"/>
                            </WrapPanel>
                        </StackPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding RevealAtEdge}"/>
                            <TextBlock Text="Einblenden, wenn die Maus an den unteren Bildschirmrand fährt" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding RevealAtEdge}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding RevealOverFullScreen}"/>
                            <TextBlock Style="{StaticResource Label}">
                                … auch über Vollbild-Programmen
                                <LineBreak/><Run Text="Aus: In Spielen (auch Fenster-Vollbild) und Videos kommt das Dock nur über die Windows-Taste." Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding WinKeyShowsDockFirst}"/>
                            <TextBlock Style="{StaticResource Label}">
                                Windows-Taste: 1. Druck zeigt nur das Dock, 2. Druck das Startmenü
                                <LineBreak/><Run Text="Nur wenn das Dock gerade ausgeblendet ist." Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding LiftStartMenu}"/>
                            <TextBlock Text="Startmenü, Suche und Infocenter über das Dock schieben" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding SlideAnimation}"/>
                            <TextBlock Style="{StaticResource Label}">
                                Dock nach unten aus dem Bild fahren und wieder hereinfahren
                                <LineBreak/><Run Text="Aus: Das Dock verschwindet und erscheint ohne Animation." Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding SlideAnimation}">
                            <TextBlock DockPanel.Dock="Right" Width="60" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding SlideDurationMs, StringFormat={}{0:0} ms}" Foreground="{StaticResource Sub}"/>
                            <Slider DockPanel.Dock="Right" Style="{StaticResource Slide}" Minimum="100" Maximum="800"
                                    TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding SlideDurationMs}"/>
                            <TextBlock Text="Dauer der Animation" Style="{StaticResource Label}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ============ Mehrere Bildschirme ============ -->
                <TextBlock x:Name="SecScreens" Text="Mehrere Bildschirme" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding DockOnAllScreens}"/>
                            <TextBlock Style="{StaticResource Label}">
                                Dock auf allen Bildschirmen anzeigen
                                <LineBreak/><Run Text="Jeder Bildschirm bekommt ein eigenes Dock. Der Hintergrund „Still“ bleibt auf dem Hauptbildschirm." Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding DockOnAllScreens}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding AppsOnOwnScreen}"/>
                            <TextBlock Style="{StaticResource Label}">
                                Nebenbildschirme: nur Programme mit Fenstern auf diesem Bildschirm
                                <LineBreak/><Run Text="Das Dock auf dem Hauptbildschirm zeigt immer alle. Angeheftete Programme stehen in jedem Dock." Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <StackPanel Margin="0,12,0,12" IsEnabled="{Binding WinKeyShowsDockFirst}">
                            <TextBlock Text="Windows-Taste: 1. Druck zeigt die Docks, wenn …" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <RadioButton Style="{StaticResource Segment}" GroupName="WinKeyDocks" Content="irgendein Dock ausgeblendet ist"
                                             IsChecked="{Binding WinKeyAllDocks, Converter={StaticResource Eq}, ConverterParameter=True}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="WinKeyDocks" Content="das Dock auf dem Hauptbildschirm ausgeblendet ist"
                                             IsChecked="{Binding WinKeyAllDocks, Converter={StaticResource Eq}, ConverterParameter=False}"/>
                            </WrapPanel>
                        </StackPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <StackPanel Margin="0,12,0,12" IsEnabled="{Binding ShowWallpaper}">
                            <TextBlock Margin="0,0,0,10">
                                Hintergrund „Still“ auf Nebenbildschirmen
                                <LineBreak/><Run Text="Pillen und Karten gibt es nur auf dem Hauptbildschirm; ein Dock dort ist nicht nötig." Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                            <WrapPanel>
                                <RadioButton Style="{StaticResource Segment}" GroupName="WpSecondary" Content="Aus"
                                             IsChecked="{Binding WallpaperSecondary, Converter={StaticResource Eq}, ConverterParameter=Off}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="WpSecondary" Content="Nur Licht"
                                             IsChecked="{Binding WallpaperSecondary, Converter={StaticResource Eq}, ConverterParameter=Light}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="WpSecondary" Content="Licht mit Uhr und Datum"
                                             IsChecked="{Binding WallpaperSecondary, Converter={StaticResource Eq}, ConverterParameter=Clock}"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ Aufklapp-Fenster ============ -->
                <TextBlock x:Name="SecFlyouts" Text="Aufklapp-Fenster" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding HoverOpensFolders}"/>
                            <TextBlock Text="Desktop und Ordner öffnen sich beim Drüberfahren" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding WindowPreviews}"/>
                            <TextBlock Text="Fenstervorschau beim Drüberfahren über laufende Programme" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" Width="60" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding HoverDelayMs, StringFormat={}{0:0} ms}" Foreground="{StaticResource Sub}"/>
                            <Slider DockPanel.Dock="Right" Style="{StaticResource Slide}" Minimum="0" Maximum="1500"
                                    TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding HoverDelayMs}"/>
                            <TextBlock Text="Verzögerung beim Drüberfahren" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" Width="60" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding FlyoutGap, StringFormat={}{0:0} px}" Foreground="{StaticResource Sub}"/>
                            <Slider DockPanel.Dock="Right" Style="{StaticResource Slide}" Minimum="0" Maximum="60"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FlyoutGap}"/>
                            <TextBlock Text="Abstand von Desktop-Fenster, Vorschau und ausgeblendeten Symbolen zum Dock" Style="{StaticResource Label}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ============ Hintergrund ============ -->
                <TextBlock x:Name="SecWallpaper" Text="Hintergrund" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowWallpaper}"/>

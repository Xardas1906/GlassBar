                                <LineBreak/><Run Text="Ersetzt Wallpaper Engine: Beende Wallpaper Engine, wenn du das einschaltest. Läuft ohne Browser direkt in GlassBar." Foreground="{StaticResource Sub}" FontSize="12"/>
                                <LineBreak/><Run Text="Nachbau des Originals " Foreground="{StaticResource Sub}" FontSize="12"/><Hyperlink
                                    NavigateUri="https://steamcommunity.com/sharedfiles/filedetails/?id=3829782620" RequestNavigate="Link_Navigate"
                                    Foreground="{StaticResource Accent}" FontSize="12">„Still“ von MrShadow (Steam Workshop)</Hyperlink>
                            </TextBlock>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <StackPanel Margin="0,12,0,6" IsEnabled="{Binding ShowWallpaper}">
                            <TextBlock Margin="0,0,0,10">
                                Hinter Uhr und Pillen
                                <LineBreak/><Run Text="Uhr, Datum, Pillen und Karten bleiben bei allen drei Varianten." Foreground="{StaticResource Sub}" FontSize="12"/>
                            </TextBlock>
                            <WrapPanel>
                                <RadioButton Style="{StaticResource Segment}" GroupName="WpField" Content="Lichtfeld"
                                             IsChecked="{Binding WallpaperField, Converter={StaticResource Eq}, ConverterParameter=Light}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="WpField" Content="Windows-Hintergrundbild"
                                             IsChecked="{Binding WallpaperField, Converter={StaticResource Eq}, ConverterParameter=Image}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="WpField" Content="Einfarbig"
                                             IsChecked="{Binding WallpaperField, Converter={StaticResource Eq}, ConverterParameter=Solid}"/>
                            </WrapPanel>
                        </StackPanel>

                                <RadioButton Style="{StaticResource Segment}" GroupName="StartLogoStyle" Content="Bunt"
                                             IsChecked="{Binding StartLogoStyle, Converter={StaticResource Eq}, ConverterParameter=Colorful}"/>
                            </WrapPanel>
                        </StackPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <RadioButton Style="{StaticResource Swatch}" Background="#FFFFFF" ToolTip="Weiß" GroupName="StartLogoColor"
                                             IsChecked="{Binding StartLogoColor, Converter={StaticResource Eq}, ConverterParameter=White}"/>

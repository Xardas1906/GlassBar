<Window x:Class="GlassBar.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="GlassBar"
        WindowStyle="None" Background="Transparent" SizeToContent="WidthAndHeight" ShowActivated="False" Left="-30000"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Werden von den Einstellungen live gesetzt -->
        <sys:Double x:Key="IconSize">30</sys:Double>
        <sys:Double x:Key="SlotSize">42</sys:Double>
        <sys:Double x:Key="DotOpacity">1</sys:Double>

        <!-- Dock-Platz: dezenter Hintergrund beim Drüberfahren, keine Vergrößerung -->
        <Style x:Key="DockSlot" TargetType="Border">
            <Setter Property="Width" Value="{DynamicResource SlotSize}"/>
            <Setter Property="Height" Value="{DynamicResource SlotSize}"/>
            <Setter Property="Margin" Value="1,4"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1EFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DockIcon" TargetType="FrameworkElement">
            <Setter Property="Width" Value="{DynamicResource IconSize}"/>
            <Setter Property="Height" Value="{DynamicResource IconSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- App im Dock: angeheftet und/oder laufend -->
        <DataTemplate x:Key="AppTemplate">
            <Border x:Name="Bd" Style="{StaticResource DockSlot}" ToolTip="{Binding Title}" AllowDrop="True"
                    MouseEnter="App_MouseEnter" MouseLeave="App_MouseLeave"
                    PreviewMouseLeftButtonDown="App_MouseDown" MouseMove="App_MouseMove" MouseUp="App_MouseUp"
                    DragOver="App_DragOver" Drop="App_Drop">
                <Grid>
                    <Image Source="{Binding Icon}" Style="{StaticResource DockIcon}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Ellipse x:Name="Dot" Width="4" Height="4" Fill="#D0FFFFFF" VerticalAlignment="Bottom"
                             Margin="0,0,0,1" Visibility="Hidden" Opacity="{DynamicResource DotOpacity}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Bd" Property="ToolTip" Value="{x:Null}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Accent}"/>
                    <Setter TargetName="Dot" Property="Width" Value="5"/>
                    <Setter TargetName="Dot" Property="Height" Value="5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="#FFA94D"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Tray-Icons -->
        <DataTemplate x:Key="TrayTemplate">
            <Border Style="{StaticResource BarButton}" Width="28" Height="36" Margin="0"
                    ToolTip="{Binding Title}"
                    MouseEnter="Tray_MouseEnter" MouseLeave="Tray_MouseLeave" MouseMove="Tray_MouseMove"
                    MouseDown="Tray_MouseDown" MouseUp="Tray_MouseUp">
                <Image Source="{Binding Icon}" Width="16" Height="16"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="Horizontal">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <Style x:Key="DockSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Fill" Value="#30FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Das Dock: eine schwebende Glas-Kapsel in der Mitte, so breit wie ihr Inhalt -->
    <Border x:Name="Root" CornerRadius="8" BorderThickness="1" Padding="5,0"
            MouseRightButtonUp="Root_RightClick" AllowDrop="True" Drop="Root_Drop" DragOver="Root_DragOver">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#14FFFFFF" Offset="0"/>
                <GradientStop Color="#06FFFFFF" Offset="0.5"/>
                <GradientStop Color="#08FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#40FFFFFF" Offset="0"/>
                <GradientStop Color="#14FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <StackPanel Orientation="Horizontal">
            <!-- Start -->
            <Border x:Name="StartButton" Style="{StaticResource DockSlot}" ToolTip="Start"
                    MouseLeftButtonUp="Start_Click" MouseRightButtonUp="Start_RightClick">
                <Border x:Name="StartTile" Style="{StaticResource DockIcon}" CornerRadius="8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4CC2FF" Offset="0"/>
                            <GradientStop Color="#2563EB" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                    <Image x:Name="StartImage" Stretch="UniformToFill" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Grid x:Name="StartLogo" Width="16" Height="16">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <Rectangle Fill="White" Margin="0,0,1,1"/>
                        <Rectangle Grid.Column="1" Fill="White" Margin="1,0,0,1"/>
                        <Rectangle Grid.Row="1" Fill="White" Margin="0,1,1,0"/>
                        <Rectangle Grid.Row="1" Grid.Column="1" Fill="White" Margin="1,1,0,0"/>
                    </Grid>
                    </Grid>
                </Border>
            </Border>
            <!-- Suche -->
            <Border x:Name="SearchButton" Style="{StaticResource DockSlot}" ToolTip="Suchen" MouseLeftButtonUp="Search_Click">
                <Border Style="{StaticResource DockIcon}" CornerRadius="8" Background="#3AFFFFFF">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="15"/>
                </Border>
            </Border>
            <!-- Aktive Anwendungen -->
            <Border x:Name="TaskViewButton" Style="{StaticResource DockSlot}" ToolTip="Aktive Anwendungen" MouseLeftButtonUp="TaskView_Click">
                <Border Style="{StaticResource DockIcon}" CornerRadius="8" Background="#3AFFFFFF">
                    <TextBlock Text="&#xE7C4;" Style="{StaticResource Glyph}" FontSize="15"/>
                </Border>
            </Border>

            <Rectangle x:Name="Sep1" Style="{StaticResource DockSeparator}"/>

            <!-- Apps -->
            <ItemsControl x:Name="AppList" ItemTemplate="{StaticResource AppTemplate}"
                          ItemsPanel="{StaticResource Horizontal}"/>

            <!-- Was gerade läuft: Cover, Titel, Tasten (wie die Musik-Pille im Hintergrund „Still“) -->
            <Rectangle x:Name="SepMusic" Style="{StaticResource DockSeparator}" Visibility="Collapsed"/>
            <Border x:Name="MusicPill" Visibility="Collapsed" CornerRadius="8" Margin="2,5" Padding="5,0,4,0"
                    Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                    MouseLeftButtonUp="Music_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="MusicCover" Width="30" Height="30" CornerRadius="5" Background="#30FFFFFF">
                        <TextBlock x:Name="MusicNoCover" Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="13" Opacity="0.7"/>
                    </Border>
                    <StackPanel Width="132" Margin="8,0,4,0" VerticalAlignment="Center">
                        <TextBlock x:Name="MusicTitle" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="MusicArtist" Foreground="#B0FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Style="{StaticResource BarButton}" Width="26" Height="28" Margin="0" ToolTip="Vorheriger Titel"
                            MouseLeftButtonUp="MusicPrev_Click">
                        <TextBlock Text="&#xE892;" Style="{StaticResource Glyph}" FontSize="11"/>
                    </Border>
                    <Border Style="{StaticResource BarButton}" Width="28" Height="28" Margin="0" ToolTip="Abspielen / Pause"
                            MouseLeftButtonUp="MusicPlay_Click">
                        <TextBlock x:Name="MusicPlayGlyph" Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="13"/>
                    </Border>
                    <Border Style="{StaticResource BarButton}" Width="26" Height="28" Margin="0" ToolTip="Nächster Titel"
                            MouseLeftButtonUp="MusicNext_Click">
                        <TextBlock Text="&#xE893;" Style="{StaticResource Glyph}" FontSize="11"/>
                    </Border>
                </StackPanel>
            </Border>

            <Rectangle x:Name="Sep2" Style="{StaticResource DockSeparator}"/>

            <!-- Desktop-Stapel (wie die Stapel rechts im Mac-Dock) -->
            <Border x:Name="DesktopButton" Style="{StaticResource DockSlot}" ToolTip="Desktop"
                    MouseEnter="Desktop_MouseEnter" MouseLeave="Desktop_MouseLeave"
                    MouseLeftButtonUp="Desktop_Click" MouseRightButtonUp="Desktop_RightClick">
                <Grid>
                    <Image x:Name="DesktopIcon" Source="{Binding JumboIcon}" Style="{StaticResource DockIcon}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <!-- Eigene Symbole (Einstellung „Symbol des Desktop-Stapels“) -->
                    <Border x:Name="DesktopTile" Style="{StaticResource DockIcon}" CornerRadius="8" Visibility="Collapsed" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="DesktopGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="DesktopImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Rectangle x:Name="Sep3" Style="{StaticResource DockSeparator}"/>

            <!-- Infobereich, Schnelleinstellungen, Uhr -->
            <StackPanel x:Name="RightArea" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="OverflowButton" Style="{StaticResource BarButton}" Width="26" Height="36"
                        ToolTip="Ausgeblendete Symbole anzeigen" MouseLeftButtonUp="Overflow_Click">
                    <TextBlock Text="&#xE70E;" Style="{StaticResource Glyph}" FontSize="11"/>
                </Border>
                <ItemsControl x:Name="TrayList" ItemTemplate="{StaticResource TrayTemplate}"
                              ItemsPanel="{StaticResource Horizontal}"/>
                <!-- Wetter (Open-Meteo) -->
                <Border x:Name="WeatherButton" Style="{StaticResource BarButton}" Height="36" Padding="8,0"
                        Visibility="Collapsed" MouseLeftButtonUp="Weather_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="WeatherGlyph" FontFamily="Segoe UI Symbol" FontSize="15" Foreground="White"
                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="WeatherTemp" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="QuickSettingsButton" Style="{StaticResource BarButton}" Height="36" Padding="8,0"
                        ToolTip="Schnelleinstellungen" MouseLeftButtonUp="QuickSettings_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="NetGlyph" Text="&#xE701;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock Text="&#xE767;" Style="{StaticResource Glyph}" FontSize="14"/>
                        <TextBlock x:Name="BatteryGlyph" Style="{StaticResource Glyph}" FontSize="14" Margin="10,0,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <Border x:Name="ClockButton" Style="{StaticResource BarButton}" Padding="8,0" Height="38"
                        MouseLeftButtonUp="Clock_Click">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TimeText" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="DateText" Foreground="#D0FFFFFF" FontSize="11" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <!-- Desktop anzeigen: schmaler Knopf ganz rechts wie bei der Windows-Taskleiste -->
            <Border x:Name="PeekButton" Width="10" Height="34" Margin="6,0,0,0" CornerRadius="4" Cursor="Hand"
                    VerticalAlignment="Center" ToolTip="Desktop anzeigen"
                    MouseLeftButtonUp="ShowDesktop_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Hintergrund im Stil, sonst überschreibt er den Hover-Trigger -->
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Rectangle Width="1" Height="18" HorizontalAlignment="Left" Fill="#50FFFFFF"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
